{
  // Relaxed rules — docs favor readability over strict style.
  "default": true,
  "MD013": false, // line length (prose is wrapped naturally)
  "MD033": false, // inline HTML
  "MD034": false, // bare URLs (used in lineage/source citations)
  "MD024": { "siblings_only": true }, // duplicate headings allowed across sections
  "MD041": false, // first line need not be a top-level heading
  "MD040": false, // fenced code language not required
  "MD036": false  // emphasis-as-heading (used for callout labels)
}
